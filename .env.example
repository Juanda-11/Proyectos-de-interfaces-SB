# Entorno
NODE_ENV=development
PORT=3001

# Gemini (capa gratuita): la clave se genera en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo principal y modelos de respaldo (separados por comas) si el principal no responde
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=20000

# Orígenes permitidos (CORS), separados por comas. Admite comodines de subdominio.
# Ejemplo: https://workerwatch.vercel.app,https://*.vercel.app,http://localhost:8081
CORS_ORIGINS=*

# Límite de peticiones por IP y minuto
RATE_LIMIT_PER_MINUTE=30

# (Opcional) URL base alternativa de la API de Gemini, útil para proxies o pruebas locales
# GEMINI_BASE_URL=
